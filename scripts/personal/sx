#!/usr/bin/env bash

# Use current directory as project root
WORKDIR="$(pwd)"

# Session name = current folder name, sanitized for tmux
PROJECT_NAME="$(basename "$WORKDIR")"
SESH="$(printf '%s' "$PROJECT_NAME" | sed -E 's/[^a-zA-Z0-9_-]/_/g')"

# Detect project type
BUILD_NAME="compile"
BUILD_CMD=""

if [[ -f "$WORKDIR/Cargo.toml" ]]; then
    BUILD_NAME="compile"
    BUILD_CMD="cargo run"
elif [[ -f "$WORKDIR/main.cpp" ]]; then
    BUILD_NAME="compile"
    BUILD_CMD="g++ main.cpp -o main"
elif [[ -f "$WORKDIR/build.zig" ]]; then
    BUILD_NAME="compile"
    BUILD_CMD="zig build"
elif [[ -f "$WORKDIR/package.json" ]]; then
    BUILD_NAME="server"
    BUILD_CMD=""
fi

if ! tmux has-session -t "$SESH" 2>/dev/null; then
    tmux new-session -d -s "$SESH" -n nvim -c "$WORKDIR"
    tmux send-keys -t "$SESH:nvim" "nvim" C-m

    tmux new-window -t "$SESH" -n "$BUILD_NAME" -c "$WORKDIR"
    tmux send-keys -t "$SESH:$BUILD_NAME" "clear" C-m

    if [[ -n "$BUILD_CMD" ]]; then
        tmux send-keys -t "$SESH:$BUILD_NAME" "$BUILD_CMD" C-m
    fi

    tmux new-window -t "$SESH" -n lazygit -c "$WORKDIR"
    tmux send-keys -t "$SESH:lazygit" "clear" C-m
    tmux send-keys -t "$SESH:lazygit" "test -d .git || git init" C-m
    tmux send-keys -t "$SESH:lazygit" "lazygit" C-m

    # agent
    tmux new-window -t "$SESH" -n agent -c "$WORKDIR"
    tmux send-keys -t "$SESH:agent" "clear" C-m
    tmux send-keys -t "$SESH:agent" "pi" C-m

    tmux select-window -t "$SESH:nvim"
fi

tmux attach-session -t "$SESH"
