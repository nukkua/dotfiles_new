vim.keymap.set("n", "<leader>cr", function()
    local makeprg = vim.fn.expandcmd(vim.bo.makeprg ~= "" and vim.bo.makeprg or vim.o.makeprg)
    local output = {}

    vim.fn.jobstart(makeprg, {
        stdout_buffered = true,
        stderr_buffered = true,
        on_stdout = function(_, data)
            if data then vim.list_extend(output, data) end
        end,
        on_stderr = function(_, data)
            if data then vim.list_extend(output, data) end
        end,
        on_exit = function(_, code)
            vim.schedule(function()
                vim.fn.setqflist({}, "r", {
                    title = makeprg,
                    lines = output,
                    efm = vim.bo.errorformat,
                })
                if code ~= 0 then
                    vim.cmd("cwindow")
                else
                    vim.cmd("cclose")
                    vim.notify("make ok", vim.log.levels.INFO)
                end
            end)
        end,
    })
end)

